<?xml version="1.0" encoding="utf-8"?>
<!-- A to-do row's priority dot (low) — plain filled circle in the semantic
     color resource, so day/night adapts for free via the resource
     qualifiers already on widget_ink_faint/widget_accent/widget_danger,
     with no need to tint anything at runtime from Kotlin. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="8dp"
    android:height="8dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@color/widget_ink_faint"
        android:pathData="M12,2 A10,10 0 1,1 11.99,2 Z"/>
</vector>
