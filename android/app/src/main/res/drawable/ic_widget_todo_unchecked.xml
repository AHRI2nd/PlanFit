<?xml version="1.0" encoding="utf-8"?>
<!-- Empty ring — an undone to-do row in the HomeScreen widget. Two separate
     drawables (this + ic_widget_todo_checked) rather than one dynamically
     tinted/recolored resource — RemoteViews can't easily swap a vector's
     internal path color from Kotlin without API 31+, but swapping the whole
     drawable resource via setImageViewResource works on every version. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/widget_ink_faint"
        android:strokeWidth="2"
        android:pathData="M12,2 A10,10 0 1,1 11.99,2 Z"/>
</vector>
