<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_next_event_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_widget_upcoming_label"
        android:textColor="@color/widget_ink_faint"
        android:textSize="12sp"/>

    <TextView
        android:id="@+id/widget_events_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/home_widget_empty_event"
        android:textColor="@color/widget_ink"
        android:textSize="15sp"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/widget_event0_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_event0_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_ink"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/widget_event0_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/widget_accent"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_event1_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_event1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_ink"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/widget_event1_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/widget_ink_faint"
            android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_event2_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_event2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_ink"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/widget_event2_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/widget_ink_faint"
            android:textSize="13sp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Tapping the label/progress row (not the checkable rows below, each of
         which has its own tap target) deep-links to today in the schedule tab. -->
    <LinearLayout
        android:id="@+id/widget_todos_tap_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_todos_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_widget_todos_label"
            android:textColor="@color/widget_ink_faint"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/widget_todos_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_ink_faint"
            android:textSize="12sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_todos_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/home_widget_empty_todos"
        android:textColor="@color/widget_ink_faint"
        android:textSize="13sp"
        android:visibility="gone"/>

    <!-- Up to 3 of today's to-dos, checkable right here — see the matching
         comment in home_widget_layout.xml. -->
    <LinearLayout
        android:id="@+id/widget_todo0_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_todo0_check"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_todo_unchecked"/>

        <ImageView
            android:id="@+id/widget_todo0_priority"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="6dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/widget_todo0_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_ink"
            android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_todo1_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_todo1_check"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_todo_unchecked"/>

        <ImageView
            android:id="@+id/widget_todo1_priority"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="6dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/widget_todo1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_ink"
            android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_todo2_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_todo2_check"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_todo_unchecked"/>

        <ImageView
            android:id="@+id/widget_todo2_priority"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="6dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/widget_todo2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_ink"
            android:textSize="14sp"/>
    </LinearLayout>

</LinearLayout>
