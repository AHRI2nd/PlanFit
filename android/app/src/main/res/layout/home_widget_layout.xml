<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Tapping this section deep-links to the event's day; falls back to
         plain launch when there's no upcoming event (see PlanFitWidgetProvider). -->
    <LinearLayout
        android:id="@+id/widget_event_tap_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_next_event_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_widget_upcoming_label"
            android:textColor="@color/widget_ink_faint"
            android:textSize="12sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_next_event_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_ink"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/widget_next_event_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/widget_accent"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Tapping the label/progress row (not the checkable rows below, each of
         which has its own tap target) deep-links to today in the schedule tab. -->
    <LinearLayout
        android:id="@+id/widget_todos_tap_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_todos_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_widget_todos_label"
            android:textColor="@color/widget_ink_faint"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/widget_todos_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_ink_faint"
            android:textSize="12sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_todos_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/home_widget_empty_todos"
        android:textColor="@color/widget_ink_faint"
        android:textSize="13sp"
        android:visibility="gone"/>

    <!-- Up to 2 of today's to-dos, checkable right here — tapping a row
         toggles it via PlanFitWidgetProvider's background broadcast, without
         opening the app (see HomeWidgetBackgroundReceiver). -->
    <LinearLayout
        android:id="@+id/widget_todo0_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_todo0_check"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_todo_unchecked"/>

        <ImageView
            android:id="@+id/widget_todo0_priority"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="6dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/widget_todo0_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_ink"
            android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_todo1_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_todo1_check"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_todo_unchecked"/>

        <ImageView
            android:id="@+id/widget_todo1_priority"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="6dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/widget_todo1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_ink"
            android:textSize="14sp"/>
    </LinearLayout>

</LinearLayout>
